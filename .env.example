# Website talks to Express via a thin NextAuth/cookie BFF proxy.
# Copy this to .env and fill in the values.

# Database (SSR pages + NextAuth credentials login)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/getmaterials

# Auth
AUTH_SECRET=your-auth-secret-here
AUTH_URL=http://localhost:3001
# Must match server JWT_SECRET / AUTH_SECRET
JWT_SECRET=your-auth-secret-here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_COURSES_URL=http://localhost:3003
NEXT_PUBLIC_ARENA_URL=https://arena.getmaterials.in
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-EKNR66122Z

# Continue with Google: OAuth web client. Add the site origin under "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=377241660777-hs3iovq384958o21a1d284hg3ibr294p.apps.googleusercontent.com
# Continue with Apple: Services ID. The Apple button stays hidden until this is set.
NEXT_PUBLIC_APPLE_CLIENT_ID=
# Must be registered as a Return URL on the Services ID (defaults to <origin>/login)
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# Express API origin used by the server-side proxy
API_INTERNAL_URL=http://localhost:4000
